# Copy to .env for local Docker Compose only. Replace all placeholders.
APP_ENV=development
PUBLIC_PORT=8088
WEB_ORIGIN=http://localhost:8088
API_PORT=8080
AI_PORT=8000

POSTGRES_DB=lostlink
POSTGRES_USER=lostlink
POSTGRES_PASSWORD=replace-me-local-only
DATABASE_URL=postgres://lostlink:replace-me-local-only@postgres:5432/lostlink?sslmode=disable

MINIO_ROOT_USER=replace-me-local-only
MINIO_ROOT_PASSWORD=replace-me-local-only
STORAGE_ENDPOINT=minio:9000
STORAGE_BUCKET=lostlink-dev
STORAGE_ACCESS_KEY=replace-me-local-only
STORAGE_SECRET_KEY=replace-me-local-only
STORAGE_USE_SSL=false

# Local authentication defaults. Replace the signing key before shared use.
JWT_ISSUER=lostlink-api
JWT_AUDIENCE=lostlink-web
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h
JWT_SIGNING_KEY=replace-me-with-at-least-32-random-bytes
